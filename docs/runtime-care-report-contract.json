{
  "schemas": {
    "ReportCitation": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "maxLength": 400,
          "minLength": 2,
          "title": "Quote",
          "type": "string"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "title": "ReportCitation",
      "type": "object"
    },
    "ReportDialogueSource": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "answer_id": {
          "format": "uuid",
          "title": "Answer Id",
          "type": "string"
        },
        "answer_truncated": {
          "title": "Answer Truncated",
          "type": "boolean"
        },
        "answered_at": {
          "format": "date-time",
          "title": "Answered At",
          "type": "string"
        },
        "question": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "question_at": {
          "format": "date-time",
          "title": "Question At",
          "type": "string"
        },
        "question_id": {
          "format": "uuid",
          "title": "Question Id",
          "type": "string"
        },
        "question_truncated": {
          "title": "Question Truncated",
          "type": "boolean"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "thread_id": {
          "format": "uuid",
          "title": "Thread Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "thread_id",
        "question_id",
        "answer_id",
        "question",
        "answer",
        "question_at",
        "answered_at",
        "question_truncated",
        "answer_truncated"
      ],
      "title": "ReportDialogueSource",
      "type": "object"
    },
    "ReportFinding": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/components/schemas/ReportCitation"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "text": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "title": "ReportFinding",
      "type": "object"
    },
    "ReportGenerationInput": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "episode_id": {
          "format": "uuid",
          "title": "Episode Id",
          "type": "string"
        },
        "omitted_count": {
          "minimum": 0.0,
          "title": "Omitted Count",
          "type": "integer"
        },
        "purpose": {
          "default": "daily",
          "enum": [
            "daily",
            "preparation"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "report_date": {
          "format": "date",
          "title": "Report Date",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/components/schemas/ReportSource"
          },
          "maxItems": 120,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "timezone": {
          "maxLength": 80,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "episode_id",
        "report_date",
        "timezone",
        "as_of",
        "sources",
        "omitted_count"
      ],
      "title": "ReportGenerationInput",
      "type": "object"
    },
    "ReportGenerationResult": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/components/schemas/StructuredCareReport"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "model": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "const": "care_report.2026-09-08.v1",
          "default": "care_report.2026-09-08.v1",
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_response_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Provider Response Id",
          "type": "string"
        },
        "schema_version": {
          "const": "care_report.v1",
          "default": "care_report.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "content",
        "input_hash",
        "provider",
        "model",
        "provider_response_id"
      ],
      "title": "ReportGenerationResult",
      "type": "object"
    },
    "ReportSource": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "dialogue",
            "intake",
            "lactation",
            "care_plan",
            "baby_record"
          ],
          "title": "Kind",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "recorded_at",
        "content"
      ],
      "title": "ReportSource",
      "type": "object"
    },
    "ReportSourceQuery": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "limit": {
          "default": 40,
          "maximum": 50.0,
          "minimum": 1.0,
          "title": "Limit",
          "type": "integer"
        },
        "owner_user_id": {
          "format": "uuid",
          "title": "Owner User Id",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        },
        "threads": {
          "items": {
            "$ref": "#/components/schemas/ReportThreadSource"
          },
          "maxItems": 100,
          "title": "Threads",
          "type": "array"
        }
      },
      "required": [
        "owner_user_id",
        "threads",
        "starts_at",
        "ends_at",
        "as_of"
      ],
      "title": "ReportSourceQuery",
      "type": "object"
    },
    "ReportSourcesRead": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "available_count": {
          "minimum": 0.0,
          "title": "Available Count",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/components/schemas/ReportDialogueSource"
          },
          "maxItems": 50,
          "title": "Items",
          "type": "array"
        },
        "omitted_count": {
          "minimum": 0.0,
          "title": "Omitted Count",
          "type": "integer"
        }
      },
      "required": [
        "items",
        "available_count",
        "omitted_count",
        "as_of"
      ],
      "title": "ReportSourcesRead",
      "type": "object"
    },
    "ReportThreadSource": {
      "additionalProperties": false,
      "properties": {
        "shared_since": {
          "format": "date-time",
          "title": "Shared Since",
          "type": "string"
        },
        "shared_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Shared Until"
        },
        "thread_id": {
          "format": "uuid",
          "title": "Thread Id",
          "type": "string"
        }
      },
      "required": [
        "thread_id",
        "shared_since"
      ],
      "title": "ReportThreadSource",
      "type": "object"
    },
    "StructuredCareReport": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/components/schemas/ReportFinding"
          },
          "maxItems": 6,
          "title": "Checks",
          "type": "array"
        },
        "communication_preferences": {
          "items": {
            "$ref": "#/components/schemas/ReportFinding"
          },
          "maxItems": 3,
          "title": "Communication Preferences",
          "type": "array"
        },
        "data_gaps": {
          "items": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Data Gaps",
          "type": "array"
        },
        "emotional_state": {
          "items": {
            "$ref": "#/components/schemas/ReportFinding"
          },
          "maxItems": 3,
          "title": "Emotional State",
          "type": "array"
        },
        "summary": {
          "items": {
            "$ref": "#/components/schemas/ReportFinding"
          },
          "maxItems": 6,
          "title": "Summary",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "emotional_state",
        "communication_preferences",
        "checks",
        "data_gaps"
      ],
      "title": "StructuredCareReport",
      "type": "object"
    }
  },
  "source": "Agent Runtime OpenAPI"
}
