APP_NAME=MomCozy Production Backend
APP_VERSION=0.1.0
APP_ENV=local
LOG_LEVEL=INFO

# Local development defaults. Production should provide managed service URLs.
DATABASE_URL=postgresql+asyncpg://momcozy:momcozy@localhost:5432/momcozy
REDIS_URL=redis://localhost:6379/0

# Object storage defaults to local filesystem in development.
# Production must switch this to a managed S3-compatible provider.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=production_backend/.local/object_storage
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
FILE_UPLOAD_MAX_BYTES=10485760

# Access-token verification. Local tests may inject explicit Settings instead.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_ALGORITHM=HS256

# Local/test default is false. Production always performs infrastructure checks.
READINESS_CHECK_INFRASTRUCTURE=false

# Comma-separated browser origins for web/admin clients. Leave empty for mobile
# only or local API development.
CORS_ALLOWED_ORIGINS=

# Comma-separated HTTP Host values accepted by the API. Required in production.
TRUSTED_HOSTS=

# Basic abuse protection. Disabled by default for local development; production
# should enable and tune this per environment.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
METRICS_REQUIRE_SERVICE_KEY=false

# Internal service-to-service key. Do not use this as a user-facing API key.
SERVICE_API_KEY=

# Backup/restore automation hook references. Production release preflight should
# check these with `python production_backend/scripts/check_backup_restore_hooks.py --strict`.
# Use secret-manager job names, runbook automation URLs, or deployment workflow
# identifiers here; do not put raw secrets in hook values.
POSTGRES_BACKUP_HOOK=
POSTGRES_RESTORE_HOOK=
OBJECT_STORAGE_BACKUP_HOOK=
OBJECT_STORAGE_RESTORE_HOOK=

# Agent runtime worker. Keep disabled until a real LangGraph/OpenAI Agents SDK
# handler is configured for the environment.
AGENT_RUNTIME_WORKER_ENABLED=false
AGENT_RUNTIME_WORKER_BATCH_LIMIT=10
AGENT_RUNTIME_WORKER_IDLE_SECONDS=2
AGENT_RUNTIME_RECOVER_RUNNING_OLDER_THAN_SECONDS=900
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Voice integration. Keep disabled until a production provider adapter is
# configured; use local_stub only for local/test contract checks.
VOICE_PROVIDER=disabled

# Durable side-effect worker for file cleanup and confirmed agent actions.
OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_IDLE_SECONDS=2
OUTBOX_WORKER_LEASE_SECONDS=60
