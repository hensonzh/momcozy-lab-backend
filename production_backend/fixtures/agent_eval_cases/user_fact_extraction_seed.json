          {
            "fact_key": "pregnancy.due_date_or_week",
            "operation": "set",
            "value": "30周",
            "subject": "current_pregnancy",
            "certainty": "explicit",
            "evidence": "我现在孕30周"
          }
        ]
      },
      "expected": {
        "facts": [
          {"fact_key": "pregnancy.due_date_or_week", "value": "30周", "subject": "current_pregnancy"}
        ]
      }
    },
