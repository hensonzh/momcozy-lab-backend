{
  "schema_version": "agent_fact_eval.v1",
  "suite": "user-fact-extraction",
  "description": "Deterministic observed evals for the background turn fact extractor.",
  "defaults": {
    "observed_at": "2026-07-13T08:00:00+00:00",
    "priority": "p0",
    "status": "active"
