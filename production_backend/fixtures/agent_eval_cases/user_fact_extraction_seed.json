  "cases": [
    {
      "id": "explicit_self_age_is_extracted",
      "scenario": "The current user explicitly states their own age.",
      "tags": ["positive", "self", "profile"],
      "source_user_message": "我今年35岁。",
      "recent_dialogue": [
        {"role": "user", "content": "我今年35岁。"}
      ],
      "scripted_model_output": {
        "facts": [
          {
            "fact_key": "profile.age",
            "operation": "set",
            "value": 35,
            "subject": "self",
            "certainty": "explicit",
            "evidence": "我今年35岁"
          }
        ]
      },
      "expected": {
        "facts": [
          {"fact_key": "profile.age", "value": 35, "subject": "self"}
        ]
      }
    },
    {
      "id": "explicit_current_week_is_extracted",
