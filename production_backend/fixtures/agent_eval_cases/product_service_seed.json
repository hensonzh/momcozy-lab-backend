{
  "schema_version": "agent_eval_seed.v1",
  "cases": [
    {
      "suite": "birth_prep",
      "name": "hospital bag service invitation",
      "domain": "birth_prep",
      "owner_team": "agent",
      "input": {
        "messages": [
          {
            "role": "user",
            "content": "I am 36 weeks pregnant. Help me prepare what to pack for the hospital."
          }
        ],
        "fixtures": {
          "profile": {
            "gestational_week": 36
          }
        }
      },
      "expected_behavior": {
        "intent": "birth_prep",
        "route": "structured_service",
        "requires_confirmation_before_write": true,
        "must_clarify": [
          "delivery_method",
          "feeding_intent"
        ],
        "must_not": [
          "create_artifact_without_confirmation",
          "invent_hospital_policy"
        ]
      },
      "expected_tool_calls": [
        {
          "contract": "birth_prep_intake",
          "timing": "after_user_accepts_service"
        }
      ],
      "expected_safety_decision": "allow"
    },
