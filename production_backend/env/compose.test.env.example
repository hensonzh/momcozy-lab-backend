# 服务器测试环境示例：复制为 env/compose.test.env 后部署到测试服务器。
APP_NAME="MomCozy Production Backend"
APP_VERSION=0.1.0
APP_ENV=test
LOG_LEVEL=INFO

# 测试服务器 Compose 基础设施：DB/Redis/MinIO 都是同一个 compose 项目内的容器服务。
DATABASE_URL=postgresql+asyncpg://momcozy_test:momcozy_test@postgres:5432/momcozy_test
REDIS_URL=redis://redis:6379/0
READINESS_CHECK_INFRASTRUCTURE=true

# 对象存储与素材：测试服务器使用 compose 内部 MinIO，不对外暴露 MinIO 端口。
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_LOCAL_ROOT=
OBJECT_STORAGE_BUCKET=momcozy-test
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
PRODUCT_ASSET_MANIFEST_PATH=/workspace/production_backend/assets/product-assets.manifest.json
PRODUCT_ASSET_LOCAL_ROOT=
FILE_UPLOAD_MAX_BYTES=10485760

# 认证与访问控制：测试环境可按联调阶段决定是否启用 active session。
AUTH_JWT_SECRET=test-deployment-secret-with-at-least-32-bytes
AUTH_JWT_ISSUER=momcozy-test
AUTH_JWT_AUDIENCE=momcozy-app
AUTH_JWT_ALGORITHM=HS256
AUTH_REQUIRE_ACTIVE_SESSION=false
SERVICE_API_KEY=test-service-key-with-at-least-32-bytes

# 测试服务器安全边界：建议用测试域名经反向代理访问 API。
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=api-test.example.com,localhost,127.0.0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
METRICS_REQUIRE_SERVICE_KEY=true

# 备份/恢复 hooks：测试服务器默认不接正式备份自动化。
POSTGRES_BACKUP_HOOK=
POSTGRES_RESTORE_HOOK=
OBJECT_STORAGE_BACKUP_HOOK=
OBJECT_STORAGE_RESTORE_HOOK=

# 智能体 worker：填入测试用 provider key 后再启用 worker。
AGENT_RUNTIME_WORKER_ENABLED=false
AGENT_RUNTIME_WORKER_BATCH_LIMIT=10
AGENT_RUNTIME_WORKER_CONCURRENCY=1
AGENT_RUNTIME_WORKER_IDLE_SECONDS=2
AGENT_RUNTIME_RECOVER_RUNNING_OLDER_THAN_SECONDS=900

# 智能体模型 provider：选择 openai 或 minimax；测试环境只配置当前要验证的 provider。
AGENT_MODEL_PROVIDER=openai

# OpenAI provider：默认 provider。OPENAI_MODEL 只在 AGENT_MODEL_PROVIDER=openai 时生效。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# MiniMax provider：OpenAI-compatible 接入。base URL 必须和 key 所属区域一致。
# Global: https://api.minimax.io/v1；中国大陆: https://api.minimaxi.com/v1。
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# 共享 agent loop 参数：适用于当前选中的 provider。
OPENAI_AGENT_MAX_TURNS=10
OPENAI_AGENT_TIMEOUT_SECONDS=60
OPENAI_AGENT_TRACE_ENABLED=false
OPENAI_AGENT_PROMPT_VERSION=momcozy-agent-prompt-v1

# 多模态 provider：当前默认关闭，需要接入具体服务时再启用。
VOICE_PROVIDER=disabled
VISION_PROVIDER=disabled

# Outbox：测试环境默认启用，用于验证异步副作用链路。
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_IDLE_SECONDS=2
OUTBOX_WORKER_LEASE_SECONDS=60
