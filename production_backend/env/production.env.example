# Human-readable service name used in logs, health checks, and generated docs.
APP_NAME="MomCozy Production Backend"
# Application version exposed by diagnostics and release checks.
APP_VERSION=0.1.0
# Runtime environment profile; production enables strict startup validation.
APP_ENV=production
# Minimum log level for backend process logs.
LOG_LEVEL=INFO

# Async SQLAlchemy database URL for managed production PostgreSQL.
DATABASE_URL=postgresql+asyncpg://momcozy_prod:${POSTGRES_PASSWORD}@prod-postgres.example.internal:5432/momcozy
# Redis URL for managed production Redis.
REDIS_URL=redis://:${REDIS_PASSWORD}@prod-redis.example.internal:6379/0
# Whether /ready should actively ping infrastructure dependencies.
READINESS_CHECK_INFRASTRUCTURE=true

# Object storage backend; production uses managed OSS/S3-compatible storage.
OBJECT_STORAGE_PROVIDER=oss
# Managed object storage bucket for production uploads and artifacts.
OBJECT_STORAGE_BUCKET=momcozy-prod-assets
# Managed object storage region; fill when required by provider.
OBJECT_STORAGE_REGION=
# Managed object storage endpoint URL.
OBJECT_STORAGE_ENDPOINT_URL=https://oss-prod.example.com
# Managed object storage access key id from secret manager.
OBJECT_STORAGE_ACCESS_KEY_ID=${OBJECT_STORAGE_ACCESS_KEY_ID}
# Managed object storage secret access key from secret manager.
OBJECT_STORAGE_SECRET_ACCESS_KEY=${OBJECT_STORAGE_SECRET_ACCESS_KEY}
# Local object storage root is unused for managed object storage.
OBJECT_STORAGE_LOCAL_ROOT=
# Product asset manifest path packaged with the backend image.
PRODUCT_ASSET_MANIFEST_PATH=production_backend/assets/product-assets.manifest.json
# Optional local product asset blob directory; usually empty in production.
PRODUCT_ASSET_LOCAL_ROOT=
# Maximum accepted upload size in bytes.
FILE_UPLOAD_MAX_BYTES=10485760

# JWT signing secret from secret manager.
AUTH_JWT_SECRET=${AUTH_JWT_SECRET}
# JWT issuer claim for production tokens.
AUTH_JWT_ISSUER=momcozy-production
# JWT audience claim expected by access-token verification.
AUTH_JWT_AUDIENCE=momcozy-app
# JWT signing algorithm. Current code supports HS256.
AUTH_JWT_ALGORITHM=HS256
# Whether access-token sessions must still be active in the DB.
AUTH_REQUIRE_ACTIVE_SESSION=true
# Internal service-to-service API key from secret manager.
SERVICE_API_KEY=${SERVICE_API_KEY}

# Comma-separated browser/mobile origins allowed by CORS middleware.
CORS_ALLOWED_ORIGINS=
# Comma-separated HTTP Host values accepted by trusted-host middleware.
TRUSTED_HOSTS=api.example.com
# Enables application-level request rate limiting.
RATE_LIMIT_ENABLED=true
# Maximum requests allowed inside RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_REQUESTS=120
# Rate-limit rolling window length in seconds.
RATE_LIMIT_WINDOW_SECONDS=60
# Whether metrics endpoints require SERVICE_API_KEY.
METRICS_REQUIRE_SERVICE_KEY=true

# External automation reference for PostgreSQL backups.
POSTGRES_BACKUP_HOOK=prod-postgres-backup
# External automation reference for PostgreSQL restore drills.
POSTGRES_RESTORE_HOOK=prod-postgres-restore-drill
# External automation reference for object-storage backup/versioning.
OBJECT_STORAGE_BACKUP_HOOK=prod-object-storage-versioning
# External automation reference for object-storage restore drills.
OBJECT_STORAGE_RESTORE_HOOK=prod-object-storage-restore-drill

# Enables the separate agent run worker process.
AGENT_RUNTIME_WORKER_ENABLED=false
# Maximum runnable agent runs scanned per worker cycle.
AGENT_RUNTIME_WORKER_BATCH_LIMIT=10
# Maximum agent runs processed concurrently inside one worker process.
AGENT_RUNTIME_WORKER_CONCURRENCY=2
# Sleep interval between idle worker polling cycles.
AGENT_RUNTIME_WORKER_IDLE_SECONDS=2
# Recover running agent runs older than this many seconds.
AGENT_RUNTIME_RECOVER_RUNNING_OLDER_THAN_SECONDS=900
# OpenAI API key from secret manager for production agent runs/provider evals.
OPENAI_API_KEY=${OPENAI_API_KEY}
# Model name used by the OpenAI Agents SDK runner.
OPENAI_MODEL=gpt-5.5
# Maximum tool/reasoning turns allowed for one SDK run.
OPENAI_AGENT_MAX_TURNS=10
# Timeout in seconds for one SDK run.
OPENAI_AGENT_TIMEOUT_SECONDS=60
# Whether OpenAI Agents SDK tracing should be enabled.
OPENAI_AGENT_TRACE_ENABLED=true
# Prompt version recorded on agent runs and context projections.
OPENAI_AGENT_PROMPT_VERSION=momcozy-agent-prompt-v1
# Voice provider selector; disabled means endpoints return stable disabled errors.
VOICE_PROVIDER=disabled
# Vision provider selector; disabled means image analysis is unavailable.
VISION_PROVIDER=disabled

# Enables the separate durable side-effect outbox worker process.
OUTBOX_WORKER_ENABLED=true
# Sleep interval between idle outbox worker polling cycles.
OUTBOX_WORKER_IDLE_SECONDS=2
# Lease duration in seconds for claimed outbox jobs.
OUTBOX_WORKER_LEASE_SECONDS=60
