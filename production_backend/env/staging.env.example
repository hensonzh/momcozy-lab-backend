# Staging 环境示例：复制到部署系统后通过 secret manager 注入所有 ${...} 占位值。
APP_NAME="MomCozy Production Backend"
APP_VERSION=0.1.0
APP_ENV=staging
LOG_LEVEL=INFO

# Staging 基础设施：必须指向托管 PostgreSQL/Redis，避免误连本机服务。
DATABASE_URL=postgresql+asyncpg://momcozy_staging:${POSTGRES_PASSWORD}@staging-postgres.example.internal:5432/momcozy_staging
REDIS_URL=redis://:${REDIS_PASSWORD}@staging-redis.example.internal:6379/0
READINESS_CHECK_INFRASTRUCTURE=true

# 对象存储与素材：staging 使用托管 OSS/S3 兼容存储，不使用本地对象存储根目录。
OBJECT_STORAGE_PROVIDER=oss
OBJECT_STORAGE_BUCKET=momcozy-staging-assets
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=https://oss-staging.example.com
OBJECT_STORAGE_ACCESS_KEY_ID=${OBJECT_STORAGE_ACCESS_KEY_ID}
OBJECT_STORAGE_SECRET_ACCESS_KEY=${OBJECT_STORAGE_SECRET_ACCESS_KEY}
OBJECT_STORAGE_LOCAL_ROOT=
PRODUCT_ASSET_MANIFEST_PATH=production_backend/assets/product-assets.manifest.json
PRODUCT_ASSET_LOCAL_ROOT=
FILE_UPLOAD_MAX_BYTES=10485760

# 认证与访问控制：staging 应启用 active session 校验，并使用独立 issuer。
AUTH_JWT_SECRET=${AUTH_JWT_SECRET}
AUTH_JWT_ISSUER=momcozy-staging
AUTH_JWT_AUDIENCE=momcozy-app
AUTH_JWT_ALGORITHM=HS256
AUTH_REQUIRE_ACTIVE_SESSION=true
AUTH_INVITE_CODES=${AUTH_INVITE_CODES}
SERVICE_API_KEY=${SERVICE_API_KEY}

# Staging 安全边界：按实际测试域名配置 CORS/Host，默认启用限流和 metrics 保护。
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=api-staging.example.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
METRICS_REQUIRE_SERVICE_KEY=true

# 备份/恢复 hooks：填入部署平台或云服务里的自动化任务名称。
POSTGRES_BACKUP_HOOK=staging-postgres-backup
POSTGRES_RESTORE_HOOK=staging-postgres-restore-drill
OBJECT_STORAGE_BACKUP_HOOK=staging-object-storage-versioning
OBJECT_STORAGE_RESTORE_HOOK=staging-object-storage-restore-drill

# 智能体 runtime：worker 是否独立启动由部署拓扑决定；模型与 key 必须可配置。
AGENT_RUNTIME_WORKER_ENABLED=false
AGENT_RUNTIME_WORKER_BATCH_LIMIT=10
AGENT_RUNTIME_WORKER_CONCURRENCY=1
AGENT_RUNTIME_WORKER_IDLE_SECONDS=2
AGENT_RUNTIME_RECOVER_RUNNING_OLDER_THAN_SECONDS=900
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_MODEL=gpt-5.5
OPENAI_AGENT_MAX_TURNS=10
OPENAI_AGENT_TIMEOUT_SECONDS=60
OPENAI_AGENT_TRACE_ENABLED=true
OPENAI_AGENT_PROMPT_VERSION=momcozy-agent-prompt-v1
VOICE_PROVIDER=disabled
VISION_PROVIDER=disabled

# Outbox：staging 默认启用独立副作用 worker，用于验证重试、租约和补偿路径。
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_IDLE_SECONDS=2
OUTBOX_WORKER_LEASE_SECONDS=60
