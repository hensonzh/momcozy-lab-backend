# 服务显示名称，用于日志、健康检查和生成文档。
APP_NAME="MomCozy Production Backend"
# 应用版本号，用于诊断、发布和健康信息。
APP_VERSION=0.1.0
# 运行环境标识；local 允许使用本地开发专用配置。
APP_ENV=local
# 后端进程日志级别。
LOG_LEVEL=INFO

# 本机开发使用的异步 SQLAlchemy PostgreSQL 连接地址。
DATABASE_URL=postgresql+asyncpg://momcozy:momcozy@localhost:5432/momcozy
# Redis 连接地址，用于锁、运行控制、流式游标和短期缓存。
REDIS_URL=redis://localhost:6379/0
# /ready 是否主动检查数据库、Redis 等基础设施。
READINESS_CHECK_INFRASTRUCTURE=true

# 对象存储提供方；local 表示使用本机文件系统。
OBJECT_STORAGE_PROVIDER=local
# 本机文件系统对象存储根目录，用于上传文件和 artifact。
OBJECT_STORAGE_LOCAL_ROOT=production_backend/.local/object_storage
# 托管对象存储 bucket；local 模式下不使用。
OBJECT_STORAGE_BUCKET=
# 托管对象存储区域；local 模式下通常为空。
OBJECT_STORAGE_REGION=
# S3/OSS/COS 等兼容对象存储的 endpoint。
OBJECT_STORAGE_ENDPOINT_URL=
# 托管对象存储访问密钥 ID；本地开发保持为空。
OBJECT_STORAGE_ACCESS_KEY_ID=
# 托管对象存储访问密钥；本地开发保持为空。
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# 产品素材清单路径，供素材 API 和智能体工具读取。
PRODUCT_ASSET_MANIFEST_PATH=production_backend/assets/product-assets.manifest.json
# 大体积产品素材的本地目录；为空表示只使用清单引用。
PRODUCT_ASSET_LOCAL_ROOT=
# 文件上传大小上限，单位为字节。
FILE_UPLOAD_MAX_BYTES=10485760

# 本地 JWT 签名密钥；复制到 local.env 后可替换。
AUTH_JWT_SECRET=local-development-secret-with-at-least-32-bytes
# JWT issuer 声明，用于访问令牌校验。
AUTH_JWT_ISSUER=momcozy-local
# JWT audience 声明，用于访问令牌校验。
AUTH_JWT_AUDIENCE=momcozy-app
# JWT 签名算法；当前代码支持 HS256。
AUTH_JWT_ALGORITHM=HS256
# 是否校验 access token 对应的设备会话仍处于有效状态。
AUTH_REQUIRE_ACTIVE_SESSION=false
# 内部服务间调用密钥，用于运维类受保护接口。
SERVICE_API_KEY=local-service-key-with-at-least-32-bytes

# CORS 允许的浏览器或移动端来源，多个值用英文逗号分隔。
CORS_ALLOWED_ORIGINS=
# 允许访问 API 的 HTTP Host，多个值用英文逗号分隔。
TRUSTED_HOSTS=
# 是否启用应用层限流。
RATE_LIMIT_ENABLED=false
# 限流窗口内允许的最大请求数。
RATE_LIMIT_REQUESTS=120
# 限流窗口长度，单位为秒。
RATE_LIMIT_WINDOW_SECONDS=60
# 指标接口是否要求 SERVICE_API_KEY。
METRICS_REQUIRE_SERVICE_KEY=false

# PostgreSQL 备份自动化任务引用。
POSTGRES_BACKUP_HOOK=
# PostgreSQL 恢复演练自动化任务引用。
POSTGRES_RESTORE_HOOK=
# 对象存储备份或版本化自动化任务引用。
OBJECT_STORAGE_BACKUP_HOOK=
# 对象存储恢复演练自动化任务引用。
OBJECT_STORAGE_RESTORE_HOOK=

# 是否启用独立的 agent run worker 进程。
AGENT_RUNTIME_WORKER_ENABLED=false
# 每个 worker 轮询周期最多扫描的可运行 agent run 数。
AGENT_RUNTIME_WORKER_BATCH_LIMIT=10
# 单个 worker 进程内并发处理的 agent run 数。
AGENT_RUNTIME_WORKER_CONCURRENCY=1
# worker 空闲时两次轮询之间的休眠秒数。
AGENT_RUNTIME_WORKER_IDLE_SECONDS=2
# 超过该秒数仍处于 running 的 agent run 可被恢复处理。
AGENT_RUNTIME_RECOVER_RUNNING_OLDER_THAN_SECONDS=900
# OpenAI API Key；只应写入被忽略的 local.env，不应提交。
OPENAI_API_KEY=
# OpenAI Agents SDK runner 使用的模型名称。
OPENAI_MODEL=gpt-5.5
# 单次 SDK run 允许的最大工具/推理轮次。
OPENAI_AGENT_MAX_TURNS=10
# 单次 SDK run 超时时间，单位为秒。
OPENAI_AGENT_TIMEOUT_SECONDS=60
# 是否启用 OpenAI Agents SDK tracing。
OPENAI_AGENT_TRACE_ENABLED=false
# 智能体 prompt 版本，会记录到 run 和上下文投影中。
OPENAI_AGENT_PROMPT_VERSION=momcozy-agent-prompt-v1
# 语音服务提供方；disabled 表示语音接口返回稳定禁用错误。
VOICE_PROVIDER=disabled
# 视觉服务提供方；disabled 表示图片分析不可用。
VISION_PROVIDER=disabled

# 是否启用独立的持久副作用 outbox worker 进程。
OUTBOX_WORKER_ENABLED=false
# outbox worker 空闲时两次轮询之间的休眠秒数。
OUTBOX_WORKER_IDLE_SECONDS=2
# outbox 任务被领取后的租约时长，单位为秒。
OUTBOX_WORKER_LEASE_SECONDS=60
