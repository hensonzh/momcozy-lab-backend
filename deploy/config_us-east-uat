# US-East UAT (B) non-secret defaults for the planned single-host Compose stack.
# This file is not a complete env_file and does not start the stack by itself.
# Keep A's Compose project, volumes, ports, private env and release root separate.
# Backend owns the B PostgreSQL, Redis and MinIO containers and their volumes.
# B PostgreSQL will contain separate momcozy_lab_backend_uat and
# momcozy_lab_agent_uat databases, with separate service roles.
# B Redis is one self-hosted service: Product and Agent use logical DB 0 with
# existing distinct key prefixes: Product rate-limit:* and product:*;
# Agent agent-runtime:* and momcozy-agent-runtime:*. Use distinct ACL users.
# B MinIO is one self-hosted service with Product and Agent private buckets.
# Inject complete DATABASE_URL, REDIS_URL, bucket and credentials only via
# the private B runtime env; do not reuse former RDS/ElastiCache/S3 credentials.
APP_ENV=staging
LOG_LEVEL=INFO
READINESS_CHECK_INFRASTRUCTURE=true
AUTH_REQUIRE_ACTIVE_SESSION=true
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
AUTH_EMAIL_FROM=noreply@mail-momcozy-uat.luteos.cloud
AUTH_SMTP_HOST=smtp.resend.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=resend
PRODUCT_ASSET_MANIFEST_PATH=/workspace/assets/product-assets.manifest.json
