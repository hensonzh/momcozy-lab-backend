# B 美东单机部署模板：复制到独立、权限 0600 的私有环境文件，绝不提交实际值。
APP_NAME="Product Backend"
APP_VERSION=0.1.0
APP_ENV=staging
MOMCOZY_B_ENV_MARKER=us-east-uat
AGENT_RUNTIME_URL=https://agent-us-dev.lute-momcozylab.luteos.cloud
# B public HTTPS requires a publicly trusted certificate; do not reuse A's internal CA.
MOMCOZY_BACKEND_TRUST_BUNDLE_FILE=/etc/ssl/certs/ca-certificates.crt
LOG_LEVEL=INFO

# Deployment topology (non-secret). Agent Runtime must use the same values.
MOMCOZY_BACKEND_COMPOSE_PROJECT=momcozy-lab-backend-us-east-uat
MOMCOZY_AGENT_COMPOSE_PROJECT=momcozy-lab-agent-us-east-uat
MOMCOZY_NETWORK_NAME=momcozy-lab-us-east-uat
MOMCOZY_BACKEND_API_BIND=127.0.0.1:8101
MOMCOZY_AGENT_API_BIND=127.0.0.1:8102
MOMCOZY_BACKEND_PUBLIC_URL=https://backend-us-dev.lute-momcozylab.luteos.cloud
MOMCOZY_AGENT_PUBLIC_URL=https://agent-us-dev.lute-momcozylab.luteos.cloud
MOMCOZY_POSTGRES_ADMIN_USER=momcozy_us_east_uat_admin
MOMCOZY_PRODUCT_POSTGRES_DB=momcozy_lab_backend_uat
MOMCOZY_PRODUCT_POSTGRES_USER=momcozy_lab_backend_uat
MOMCOZY_AGENT_POSTGRES_DB=momcozy_lab_agent_uat
MOMCOZY_AGENT_POSTGRES_USER=momcozy_lab_agent_uat
MOMCOZY_PRODUCT_MINIO_BUCKET=momcozy-product-us-east-uat
MOMCOZY_AGENT_MINIO_BUCKET=momcozy-agent-us-east-uat

# 复制后为以下各项生成不同的 URL-safe 随机值；Product Backend Compose 是共享基础设施所有者。
MOMCOZY_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_US_EAST_UAT_MOMCOZY_POSTGRES_ADMIN_PASSWORD
MOMCOZY_PRODUCT_POSTGRES_PASSWORD=REPLACE_WITH_US_EAST_UAT_MOMCOZY_PRODUCT_POSTGRES_PASSWORD
MOMCOZY_AGENT_POSTGRES_PASSWORD=REPLACE_WITH_US_EAST_UAT_MOMCOZY_AGENT_POSTGRES_PASSWORD
MOMCOZY_REDIS_ADMIN_PASSWORD=REPLACE_WITH_US_EAST_UAT_MOMCOZY_REDIS_ADMIN_PASSWORD
MOMCOZY_PRODUCT_REDIS_PASSWORD=REPLACE_WITH_US_EAST_UAT_MOMCOZY_PRODUCT_REDIS_PASSWORD
MOMCOZY_AGENT_REDIS_PASSWORD=REPLACE_WITH_US_EAST_UAT_MOMCOZY_AGENT_REDIS_PASSWORD
MOMCOZY_MINIO_ROOT_USER=REPLACE_WITH_US_EAST_UAT_MOMCOZY_MINIO_ROOT_USER
MOMCOZY_MINIO_ROOT_PASSWORD=REPLACE_WITH_US_EAST_UAT_MOMCOZY_MINIO_ROOT_PASSWORD
MOMCOZY_PRODUCT_MINIO_ACCESS_KEY=REPLACE_WITH_US_EAST_UAT_MOMCOZY_PRODUCT_MINIO_ACCESS_KEY
MOMCOZY_PRODUCT_MINIO_SECRET_KEY=REPLACE_WITH_US_EAST_UAT_MOMCOZY_PRODUCT_MINIO_SECRET_KEY
MOMCOZY_AGENT_MINIO_ACCESS_KEY=REPLACE_WITH_US_EAST_UAT_MOMCOZY_AGENT_MINIO_ACCESS_KEY
MOMCOZY_AGENT_MINIO_SECRET_KEY=REPLACE_WITH_US_EAST_UAT_MOMCOZY_AGENT_MINIO_SECRET_KEY

# PostgreSQL 服务共享，但 Product Backend 与 Agent Runtime 使用不同数据库和登录角色。
DATABASE_URL=postgresql+asyncpg://momcozy_lab_backend_uat:${MOMCOZY_PRODUCT_POSTGRES_PASSWORD}@postgres:5432/momcozy_lab_backend_uat
# Redis 服务共享；Product Backend 使用受 ACL 限制的独立账号、logical DB 0 和业务前缀。
REDIS_URL=redis://product-backend:${MOMCOZY_PRODUCT_REDIS_PASSWORD}@redis:6379/0
READINESS_CHECK_INFRASTRUCTURE=true

# MinIO 服务共享；Product Backend 只使用 momcozy-product-us-east-uat bucket，不暴露 MinIO 主机端口。
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_LOCAL_ROOT=
OBJECT_STORAGE_BUCKET=momcozy-product-us-east-uat
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=${MOMCOZY_PRODUCT_MINIO_ACCESS_KEY}
OBJECT_STORAGE_SECRET_ACCESS_KEY=${MOMCOZY_PRODUCT_MINIO_SECRET_KEY}
PRODUCT_ASSET_MANIFEST_PATH=/workspace/assets/product-assets.manifest.json
PRODUCT_ASSET_LOCAL_ROOT=
FILE_UPLOAD_MAX_BYTES=10485760
AGENT_MODEL_ASSET_PUBLIC_BASE_URL=https://backend-us-dev.lute-momcozylab.luteos.cloud
AGENT_MODEL_ASSET_INACTIVITY_TTL_SECONDS=1800

# 认证与访问控制：私钥为 base64 编码的未加密 PKCS#8 RSA 私钥，仅写入私有 env。
AUTH_JWT_PRIVATE_KEY_B64=REPLACE_WITH_US_EAST_UAT_AUTH_JWT_PRIVATE_KEY_B64
AUTH_JWT_ISSUER=momcozy-product-us-east-uat
AUTH_JWT_PRODUCT_AUDIENCE=momcozy-product-api
AUTH_JWT_RUNTIME_AUDIENCE=momcozy-agent-runtime
AUTH_REQUIRE_ACTIVE_SESSION=true
# 邮件注册/重置：启用时填入真实配置；真实值只写入私有 env 文件。
AUTH_EMAIL_TOKEN_KEY=REPLACE_WITH_US_EAST_UAT_AUTH_EMAIL_TOKEN_KEY
AUTH_EMAIL_FROM=noreply@mail-momcozy-uat.luteos.cloud
AUTH_SMTP_HOST=smtp.resend.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=resend
AUTH_SMTP_PASSWORD=REPLACE_WITH_US_EAST_UAT_RESEND_SENDING_KEY
# B uses email registration/login only; the invite endpoint is explicitly disabled.
AUTH_INVITE_LOGIN_ENABLED=false
AUTH_INVITE_CODES=
SERVICE_API_KEY=REPLACE_WITH_US_EAST_UAT_SERVICE_API_KEY
# Agent Runtime 使用独立服务身份，不与运维 SERVICE_API_KEY 复用。
AGENT_RUNTIME_SERVICE_API_KEY=REPLACE_WITH_US_EAST_UAT_AGENT_RUNTIME_SERVICE_API_KEY

# B host security boundary: replace reserved invalid domains before deployment.
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=backend-us-dev.lute-momcozylab.luteos.cloud,product-backend,localhost,127.0.0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AGENT_RUNTIME_RATE_LIMIT_REQUESTS=6000
AGENT_RUNTIME_RATE_LIMIT_WINDOW_SECONDS=60
METRICS_REQUIRE_SERVICE_KEY=true

# 备份/恢复 hooks：B 默认不接正式备份自动化。
POSTGRES_BACKUP_HOOK=
POSTGRES_RESTORE_HOOK=
OBJECT_STORAGE_BACKUP_HOOK=
OBJECT_STORAGE_RESTORE_HOOK=

# Product Backend 的语音转写和视觉能力可使用 OpenAI；Agent Runtime 在其独立服务中配置模型。
OPENAI_API_KEY=

# 语音播报：B 默认关闭真实豆包 TTS；契约测试可使用 local_stub，provider 单测使用 fake websocket。
VOICE_PROVIDER=disabled
VOICE_API_KEY=
VOICE_APP_ID=
VOICE_ACCESS_KEY=
VOICE_BASE_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOICE_TRANSCRIBE_MODEL=
VOICE_TTS_RESOURCE_ID=seed-tts-2.0
VOICE_TTS_VOICE_TYPE=saturn_zh_female_qingyingduoduo_cs_tob
VOICE_TTS_AUDIO_FORMAT=pcm
VOICE_TTS_SAMPLE_RATE=24000
VOICE_TTS_SPEED_RATIO=1.1
VOICE_TTS_FIRST_CHUNK_TIMEOUT_SECONDS=20
VOICE_REALTIME_MODEL=
VOICE_REQUEST_TIMEOUT_SECONDS=30

# 视觉服务：B 默认关闭真实 provider。local_stub 只用于 deterministic 契约测试。
VISION_PROVIDER=disabled
VISION_OPENAI_MODEL=gpt-5.4-mini
VISION_REQUEST_TIMEOUT_SECONDS=20

# LiveKit client/server URLs and credentials are injected only in private B env when media is enabled.


# Notification worker is inbox-only until FCM is explicitly configured.
PUSH_PROVIDER=disabled
PUSH_TOKEN_KEY=
PUSH_FCM_PROJECT_ID=
PUSH_FCM_CREDENTIALS_FILE=
# When enabled, mount a private directory as /run/momcozy-push (read-only).
# Set PUSH_FCM_CREDENTIALS_FILE=/run/momcozy-push/service-account.json.
