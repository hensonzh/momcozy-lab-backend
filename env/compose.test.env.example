# 服务器测试环境示例：复制为 env/compose.test.env 后部署到测试服务器。
APP_NAME="Backend"
APP_VERSION=0.1.0
APP_ENV=test
LOG_LEVEL=INFO

# 测试服务器 Compose 基础设施：DB/Redis/MinIO 都是同一个 compose 项目内的容器服务。
DATABASE_URL=postgresql+asyncpg://momcozy_test:momcozy_test@postgres:5432/momcozy_test
REDIS_URL=redis://redis:6379/0
READINESS_CHECK_INFRASTRUCTURE=true

# 对象存储与素材：测试服务器使用 compose 内部 MinIO，不对外暴露 MinIO 端口。
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_LOCAL_ROOT=
OBJECT_STORAGE_BUCKET=momcozy-test
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
PRODUCT_ASSET_MANIFEST_PATH=/workspace/assets/product-assets.manifest.json
PRODUCT_ASSET_LOCAL_ROOT=
FILE_UPLOAD_MAX_BYTES=10485760
AGENT_IMAGE_SIGNED_URL_TTL_SECONDS=604800

# 认证与访问控制：私钥为 base64 编码的未加密 PKCS#8 RSA 私钥，仅写入私有 env。
AUTH_JWT_PRIVATE_KEY_B64=${AUTH_JWT_PRIVATE_KEY_B64}
AUTH_JWT_ISSUER=momcozy-test
AUTH_JWT_PRODUCT_AUDIENCE=momcozy-product-api
AUTH_JWT_RUNTIME_AUDIENCE=momcozy-agent-runtime
AUTH_REQUIRE_ACTIVE_SESSION=false
AUTH_INVITE_CODES=MOMCOZY-BETA
SERVICE_API_KEY=test-service-key-with-at-least-32-bytes
# Agent Runtime 使用独立服务身份，不与运维 SERVICE_API_KEY 复用。
AGENT_RUNTIME_SERVICE_API_KEY=test-agent-runtime-service-key-with-at-least-32-bytes

# 测试服务器安全边界：建议用测试域名经反向代理访问 API。
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=api-test.example.com,localhost,127.0.0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AGENT_RUNTIME_RATE_LIMIT_REQUESTS=6000
AGENT_RUNTIME_RATE_LIMIT_WINDOW_SECONDS=60
METRICS_REQUIRE_SERVICE_KEY=true

# 备份/恢复 hooks：测试服务器默认不接正式备份自动化。
POSTGRES_BACKUP_HOOK=
POSTGRES_RESTORE_HOOK=
OBJECT_STORAGE_BACKUP_HOOK=
OBJECT_STORAGE_RESTORE_HOOK=

# Product API 的语音转写和视觉能力可使用 OpenAI；Agent Runtime 在其独立服务中配置模型。
OPENAI_API_KEY=

# 语音播报：测试默认关闭真实豆包 TTS；契约测试可使用 local_stub，provider 单测使用 fake websocket。
VOICE_PROVIDER=disabled
VOICE_API_KEY=
VOICE_APP_ID=
VOICE_ACCESS_KEY=
VOICE_BASE_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOICE_TRANSCRIBE_MODEL=
VOICE_TTS_RESOURCE_ID=seed-tts-2.0
VOICE_TTS_VOICE_TYPE=saturn_zh_female_qingyingduoduo_cs_tob
VOICE_TTS_AUDIO_FORMAT=pcm
VOICE_TTS_SAMPLE_RATE=24000
VOICE_TTS_SPEED_RATIO=1.1
VOICE_TTS_FIRST_CHUNK_TIMEOUT_SECONDS=20
VOICE_REALTIME_MODEL=
VOICE_REQUEST_TIMEOUT_SECONDS=30

# 视觉服务：测试默认关闭真实 provider。local_stub 只用于 deterministic 契约测试。
VISION_PROVIDER=disabled
VISION_OPENAI_MODEL=gpt-5.4-mini
VISION_REQUEST_TIMEOUT_SECONDS=20
