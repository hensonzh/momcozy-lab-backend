# Production Compose 环境示例：复制为 env/compose.prod.env 后在服务器上通过 Docker Compose 启动应用进程。
APP_NAME="MomCozy Production Backend"
APP_VERSION=0.1.0
APP_ENV=production
LOG_LEVEL=INFO

# Production Compose 基础设施：必须指向托管 PostgreSQL/Redis，启动校验应 fail fast。
DATABASE_URL=postgresql+asyncpg://momcozy_prod:${POSTGRES_PASSWORD}@prod-postgres.example.internal:5432/momcozy
REDIS_URL=redis://:${REDIS_PASSWORD}@prod-redis.example.internal:6379/0
READINESS_CHECK_INFRASTRUCTURE=true

# 对象存储与素材：production 使用托管 OSS/S3 兼容存储，不使用本地对象存储根目录。
OBJECT_STORAGE_PROVIDER=oss
OBJECT_STORAGE_BUCKET=momcozy-prod-assets
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=https://oss-prod.example.com
OBJECT_STORAGE_ACCESS_KEY_ID=${OBJECT_STORAGE_ACCESS_KEY_ID}
OBJECT_STORAGE_SECRET_ACCESS_KEY=${OBJECT_STORAGE_SECRET_ACCESS_KEY}
OBJECT_STORAGE_LOCAL_ROOT=
PRODUCT_ASSET_MANIFEST_PATH=assets/product-assets.manifest.json
PRODUCT_ASSET_LOCAL_ROOT=
FILE_UPLOAD_MAX_BYTES=10485760

# 认证与访问控制：production 必须启用 active session 校验，并使用生产 issuer。
AUTH_JWT_SECRET=${AUTH_JWT_SECRET}
AUTH_JWT_ISSUER=momcozy-production
AUTH_JWT_AUDIENCE=momcozy-app
AUTH_JWT_ALGORITHM=HS256
AUTH_REQUIRE_ACTIVE_SESSION=true
AUTH_INVITE_CODES=${AUTH_INVITE_CODES}
SERVICE_API_KEY=${SERVICE_API_KEY}

# Production 安全边界：按真实域名配置 CORS/Host，默认启用限流和 metrics 保护。
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=lute-momcozylab.luteos.cloud
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
METRICS_REQUIRE_SERVICE_KEY=true

# 备份/恢复 hooks：填入生产备份、恢复演练和对象存储版本化任务名称。
POSTGRES_BACKUP_HOOK=prod-postgres-backup
POSTGRES_RESTORE_HOOK=prod-postgres-restore-drill
OBJECT_STORAGE_BACKUP_HOOK=prod-object-storage-versioning
OBJECT_STORAGE_RESTORE_HOOK=prod-object-storage-restore-drill

# 智能体 worker：worker 是否独立启动由部署拓扑决定；生产建议独立扩缩容。
AGENT_RUNTIME_WORKER_ENABLED=false
AGENT_RUNTIME_WORKER_BATCH_LIMIT=10
AGENT_RUNTIME_WORKER_CONCURRENCY=2
AGENT_RUNTIME_WORKER_IDLE_SECONDS=0.1
AGENT_RUNTIME_INTERRUPT_RUNNING_OLDER_THAN_SECONDS=900

# 智能体模型固定使用已通过 eval 的 OpenAI 模型。
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_RESPONSES_STORE=false
OPENAI_AGENT_USE_RESPONSES=true

# Agent loop 参数。
OPENAI_AGENT_MAX_TURNS=10
OPENAI_AGENT_TIMEOUT_SECONDS=60
OPENAI_AGENT_TRACE_ENABLED=true
OPENAI_AGENT_PROMPT_VERSION=momcozy-agent-prompt-v4
# 快捷回复 finalizer 使用轻量模型，不影响主回复模型质量。
AGENT_QUICK_REPLY_MODEL=gpt-5.4-nano
AGENT_QUICK_REPLY_TIMEOUT_SECONDS=3.0
# 每轮后台事实提取使用独立的 OpenAI Responses 请求；本轮结果从下一轮开始生效。
AGENT_FACT_EXTRACTION_ENABLED=true
AGENT_FACT_EXTRACTION_MODEL=gpt-5.4-nano
AGENT_FACT_EXTRACTION_TIMEOUT_SECONDS=5.0
AGENT_FACT_EXTRACTION_VERSION=turn-fact-extractor-v2
AGENT_FACT_WORKER_CONCURRENCY=2
AGENT_FACT_WORKER_BATCH_LIMIT=10
AGENT_FACT_WORKER_IDLE_SECONDS=0.5
AGENT_FACT_WORKER_LEASE_SECONDS=30
AGENT_FACT_WORKER_MAX_ATTEMPTS=3
# memory-worker 服务会显式启用夜间提炼；这里保留安全默认值。
AGENT_MEMORY_CONSOLIDATION_ENABLED=false
AGENT_MEMORY_CONSOLIDATION_MODEL=gpt-5.4-nano
AGENT_MEMORY_CONSOLIDATION_TIMEOUT_SECONDS=30.0
AGENT_MEMORY_CONSOLIDATION_TIMEZONE=Asia/Shanghai
AGENT_MEMORY_CONSOLIDATION_HOUR=3
AGENT_MEMORY_CONSOLIDATION_MAX_USERS=500
AGENT_MEMORY_CONSOLIDATION_MESSAGE_LIMIT=200
AGENT_MEMORY_CONSOLIDATION_EXTRACTOR_VERSION=memory-extractor-v1
AGENT_RUNTIME_MAX_INLINE_PAYLOAD_BYTES=32768

# 语音播报：生产按旧方案使用豆包/火山实时 TTS，密钥只能来自部署环境。
VOICE_PROVIDER=doubao
VOICE_API_KEY=${VOICE_API_KEY}
VOICE_APP_ID=${VOICE_APP_ID}
VOICE_ACCESS_KEY=${VOICE_ACCESS_KEY}
VOICE_BASE_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOICE_TRANSCRIBE_MODEL=
VOICE_TTS_RESOURCE_ID=seed-tts-2.0
VOICE_TTS_VOICE_TYPE=saturn_zh_female_qingyingduoduo_cs_tob
VOICE_TTS_AUDIO_FORMAT=pcm
VOICE_TTS_SAMPLE_RATE=24000
VOICE_TTS_SPEED_RATIO=1.1
VOICE_TTS_FIRST_CHUNK_TIMEOUT_SECONDS=20
VOICE_REALTIME_MODEL=
VOICE_REQUEST_TIMEOUT_SECONDS=30

# 视觉服务：默认关闭。启用 openai 前配置 OPENAI_API_KEY 并完成真实截图质量验收。
VISION_PROVIDER=disabled
VISION_OPENAI_MODEL=gpt-5.4-mini
VISION_REQUEST_TIMEOUT_SECONDS=20

# Outbox：production 默认启用独立副作用 worker，保障持久副作用可重试、可恢复。
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_IDLE_SECONDS=2
OUTBOX_WORKER_LEASE_SECONDS=60
