# Staging 部署模板：复制为权限 0600 的私有 env/staging.env 后填写秘密。
APP_NAME="Product Backend"
APP_VERSION=0.1.0
APP_ENV=staging
AGENT_RUNTIME_URL=https://agent-test.lute-momcozylab.luteos.cloud:8443
MOMCOZY_BACKEND_TRUST_BUNDLE_FILE=/opt/momcozy-lab-staging/shared/trust-bundle.pem
LOG_LEVEL=INFO

# Deployment topology (non-secret). Agent Runtime must use the same values.
MOMCOZY_BACKEND_COMPOSE_PROJECT=momcozy-lab-backend-staging
MOMCOZY_AGENT_COMPOSE_PROJECT=momcozy-lab-agent-staging
MOMCOZY_NETWORK_NAME=momcozy-lab-staging
MOMCOZY_BACKEND_API_BIND=127.0.0.1:8001
MOMCOZY_AGENT_API_BIND=127.0.0.1:8002
MOMCOZY_BACKEND_PUBLIC_URL=https://backend-test.lute-momcozylab.luteos.cloud:8443
MOMCOZY_AGENT_PUBLIC_URL=https://agent-test.lute-momcozylab.luteos.cloud:8443
MOMCOZY_POSTGRES_ADMIN_USER=momcozy_staging_admin
MOMCOZY_PRODUCT_POSTGRES_DB=momcozy_staging
MOMCOZY_PRODUCT_POSTGRES_USER=momcozy_staging
MOMCOZY_AGENT_POSTGRES_DB=agent_runtime_staging
MOMCOZY_AGENT_POSTGRES_USER=agent_runtime_staging
MOMCOZY_PRODUCT_MINIO_BUCKET=momcozy-staging
MOMCOZY_AGENT_MINIO_BUCKET=agent-runtime-staging

# 复制后为以下各项生成不同的 URL-safe 随机值；Product Backend Compose 是共享基础设施所有者。
MOMCOZY_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_STAGING_MOMCOZY_POSTGRES_ADMIN_PASSWORD
MOMCOZY_PRODUCT_POSTGRES_PASSWORD=REPLACE_WITH_STAGING_MOMCOZY_PRODUCT_POSTGRES_PASSWORD
MOMCOZY_AGENT_POSTGRES_PASSWORD=REPLACE_WITH_STAGING_MOMCOZY_AGENT_POSTGRES_PASSWORD
MOMCOZY_REDIS_ADMIN_PASSWORD=REPLACE_WITH_STAGING_MOMCOZY_REDIS_ADMIN_PASSWORD
MOMCOZY_PRODUCT_REDIS_PASSWORD=REPLACE_WITH_STAGING_MOMCOZY_PRODUCT_REDIS_PASSWORD
MOMCOZY_AGENT_REDIS_PASSWORD=REPLACE_WITH_STAGING_MOMCOZY_AGENT_REDIS_PASSWORD
MOMCOZY_MINIO_ROOT_USER=REPLACE_WITH_STAGING_MOMCOZY_MINIO_ROOT_USER
MOMCOZY_MINIO_ROOT_PASSWORD=REPLACE_WITH_STAGING_MOMCOZY_MINIO_ROOT_PASSWORD
MOMCOZY_PRODUCT_MINIO_ACCESS_KEY=REPLACE_WITH_STAGING_MOMCOZY_PRODUCT_MINIO_ACCESS_KEY
MOMCOZY_PRODUCT_MINIO_SECRET_KEY=REPLACE_WITH_STAGING_MOMCOZY_PRODUCT_MINIO_SECRET_KEY
MOMCOZY_AGENT_MINIO_ACCESS_KEY=REPLACE_WITH_STAGING_MOMCOZY_AGENT_MINIO_ACCESS_KEY
MOMCOZY_AGENT_MINIO_SECRET_KEY=REPLACE_WITH_STAGING_MOMCOZY_AGENT_MINIO_SECRET_KEY

# PostgreSQL 服务共享，但 Product Backend 与 Agent Runtime 使用不同数据库和登录角色。
DATABASE_URL=postgresql+asyncpg://momcozy_staging:${MOMCOZY_PRODUCT_POSTGRES_PASSWORD}@postgres:5432/momcozy_staging
# Redis 服务共享；Product Backend 使用受 ACL 限制的独立账号、logical DB 0 和业务前缀。
REDIS_URL=redis://product-backend:${MOMCOZY_PRODUCT_REDIS_PASSWORD}@redis:6379/0
READINESS_CHECK_INFRASTRUCTURE=true

# MinIO 服务共享；Product Backend 只使用 momcozy-staging bucket，不暴露 MinIO 主机端口。
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_LOCAL_ROOT=
OBJECT_STORAGE_BUCKET=momcozy-staging
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=${MOMCOZY_PRODUCT_MINIO_ACCESS_KEY}
OBJECT_STORAGE_SECRET_ACCESS_KEY=${MOMCOZY_PRODUCT_MINIO_SECRET_KEY}
PRODUCT_ASSET_MANIFEST_PATH=/workspace/assets/product-assets.manifest.json
PRODUCT_ASSET_LOCAL_ROOT=
FILE_UPLOAD_MAX_BYTES=10485760
AGENT_MODEL_ASSET_PUBLIC_BASE_URL=https://backend-test.lute-momcozylab.luteos.cloud:8443
AGENT_MODEL_ASSET_INACTIVITY_TTL_SECONDS=1800

# 认证与访问控制：私钥为 base64 编码的未加密 PKCS#8 RSA 私钥，仅写入私有 env。
AUTH_JWT_PRIVATE_KEY_B64=REPLACE_WITH_STAGING_AUTH_JWT_PRIVATE_KEY_B64
AUTH_JWT_ISSUER=momcozy-staging
AUTH_JWT_PRODUCT_AUDIENCE=momcozy-product-api
AUTH_JWT_RUNTIME_AUDIENCE=momcozy-agent-runtime
AUTH_REQUIRE_ACTIVE_SESSION=false
# 邮件注册/重置：启用时填入真实配置；真实值只写入私有 env 文件。
AUTH_EMAIL_TOKEN_KEY=REPLACE_WITH_STAGING_AUTH_EMAIL_TOKEN_KEY
AUTH_EMAIL_FROM=noreply@example.com
AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_INVITE_CODES=REPLACE_WITH_STAGING_AUTH_INVITE_CODES
SERVICE_API_KEY=REPLACE_WITH_STAGING_SERVICE_API_KEY
# Agent Runtime 使用独立服务身份，不与运维 SERVICE_API_KEY 复用。
AGENT_RUNTIME_SERVICE_API_KEY=REPLACE_WITH_STAGING_SERVICE_API_KEY

# Staging 服务器安全边界：使用 test 域名经反向代理访问 API。
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=backend-test.lute-momcozylab.luteos.cloud,product-backend,localhost,127.0.0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AGENT_RUNTIME_RATE_LIMIT_REQUESTS=6000
AGENT_RUNTIME_RATE_LIMIT_WINDOW_SECONDS=60
METRICS_REQUIRE_SERVICE_KEY=true

# 备份/恢复 hooks：staging 默认不接正式备份自动化。
POSTGRES_BACKUP_HOOK=
POSTGRES_RESTORE_HOOK=
OBJECT_STORAGE_BACKUP_HOOK=
OBJECT_STORAGE_RESTORE_HOOK=

# Product Backend 的语音转写和视觉能力可使用 OpenAI；Agent Runtime 在其独立服务中配置模型。
OPENAI_API_KEY=

# 语音播报：staging 默认关闭真实豆包 TTS；契约测试可使用 local_stub，provider 单测使用 fake websocket。
VOICE_PROVIDER=disabled
VOICE_API_KEY=
VOICE_APP_ID=
VOICE_ACCESS_KEY=
VOICE_BASE_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOICE_TRANSCRIBE_MODEL=
VOICE_TTS_RESOURCE_ID=seed-tts-2.0
VOICE_TTS_VOICE_TYPE=saturn_zh_female_qingyingduoduo_cs_tob
VOICE_TTS_AUDIO_FORMAT=pcm
VOICE_TTS_SAMPLE_RATE=24000
VOICE_TTS_SPEED_RATIO=1.1
VOICE_TTS_FIRST_CHUNK_TIMEOUT_SECONDS=20
VOICE_REALTIME_MODEL=
VOICE_REQUEST_TIMEOUT_SECONDS=30

# 视觉服务：staging 默认关闭真实 provider。local_stub 只用于 deterministic 契约测试。
VISION_PROVIDER=disabled
VISION_OPENAI_MODEL=gpt-5.4-mini
VISION_REQUEST_TIMEOUT_SECONDS=20

# LiveKit client/server URLs and credentials are injected only in private staging env when media is enabled.


# Notification worker is inbox-only until FCM is explicitly configured.
PUSH_PROVIDER=disabled
PUSH_TOKEN_KEY=
PUSH_FCM_PROJECT_ID=
PUSH_FCM_CREDENTIALS_FILE=
# When enabled, mount a private directory as /run/momcozy-push (read-only).
# Set PUSH_FCM_CREDENTIALS_FILE=/run/momcozy-push/service-account.json.
