# Merge into the deployment secret environment; never commit real values.
AUTH_REQUIRE_ACTIVE_SESSION=true
# At least 32 random bytes, stable across API and mail worker restarts.
AUTH_EMAIL_TOKEN_KEY=
AUTH_EMAIL_FROM=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
# Google OAuth Web application client ID, the ID-token audience.
AUTH_GOOGLE_CLIENT_ID=
